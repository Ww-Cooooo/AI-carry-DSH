{
  "name": "eh3-dsh-ai-carry",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "AI carry-DSH: native DeepSeek Harness workflow for using AI Carry methods and reviewing sourced learning.",
  "license": "Apache-2.0",
  "engines": {
    "dsh": "0.2.2-rc.1",
    "node": ">=24.9.0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    }
  },
  "files": [
    "lib",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "NOTICE",
    "README.md",
    "vendor/ai-carry/PROVENANCE.json",
    "THIRD_PARTY_LICENSES.md",
    "licenses/*.txt",
    "licenses/dependencies/*",
    "assets/fonts/manifest.json",
    "licenses/*.pdf"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": [
        "win32"
      ]
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-api-workspace-controller"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@ant-design/icons": "6.3.4",
    "@antv/g6": "5.1.1",
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-generator": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.1",
    "@gsap/react": "2.1.2",
    "@types/node": "^24.19.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "antd": "6.7.0",
    "esbuild": "0.27.0",
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "pts": "1.0.3",
    "typescript": "~5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ww-Cooooo/AI-carry-DSH.git"
  },
  "homepage": "https://github.com/Ww-Cooooo/AI-carry-DSH#readme",
  "bugs": {
    "url": "https://github.com/Ww-Cooooo/AI-carry-DSH/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "ai-carry",
    "cordis"
  ]
}
