# Public source allowlist. Local profiles, records, evidence and research stay local.
/*
!/.gitignore
!/.gitattributes
!/package.json
!/package-lock.json
!/tsconfig.client.json
!/cordis.patch.yml
!/icon.svg
!/LICENSE
!/NOTICE
!/README.md
!/VALIDATION.md
!/THIRD_PARTY_LICENSES.md
!/src/
!/lib/
!/locale/
!/vendor/
!/licenses/
/licenses/*.html
!/test/
!/scripts/
/scripts/*
!/scripts/build.mjs
!/scripts/generate-remote.mjs
!/scripts/init-fixtures.mjs
!/scripts/third-party.mjs
!/fixtures/
/fixtures/*
!/fixtures/template/
!/assets/
/assets/*
!/assets/fonts/
/assets/fonts/*
!/assets/fonts/NotoSansSC-variable.woff2
!/assets/fonts/manifest.json
!/docs/
/docs/*
!/docs/screenshots/
!/docs/release-verification.json
!/docs/publication-manifest.json
*.log
